# Copie para .env e preencha. O .env NÃO é versionado (está no .gitignore).

# Token do bot do Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=

# Chave da API da Groq (console.groq.com > API Keys)
GROQ_API_KEY=

# ID do canal onde o bot responde (clique direito no canal > Copiar ID)
CANAL_ID=

# --- RAG (busca semântica local) — todas OPCIONAIS, têm default ---
# Pasta do índice vetorial persistido. Gerado no deploy a partir dos .md
# (não versionado); o bot builda sozinho no 1º startup se não existir.
# INDEX_DIR=content/index
# Modelo de embedding local (HuggingFace). Trocar exige rebuildar o índice.
# EMBED_MODEL=intfloat/multilingual-e5-small
# Quantos trechos o RAG recupera por pergunta.
# TOP_K=4
